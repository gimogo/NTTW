# ---- Frontend (Next.js) ----
# Address of the deployed IMDRetroWall contract (per chain you use).
# Leave empty to run the board in "offline preview" mode.
NEXT_PUBLIC_NOTES_CONTRACT_ADDRESS=

# Address of the ERC-20 token charged per stamp (set in the wall's
# constructor at deploy time — mirror it here after deploying).
NEXT_PUBLIC_PAYMENT_TOKEN_ADDRESS=

# Optional: WalletConnect Cloud project id (enables WalletConnect QR modal).
# Leave empty to use injected wallets (MetaMask, Coinbase Wallet, etc.) only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: custom frontend RPC overrides (falls back to each chain's public
# RPC when left empty).
NEXT_PUBLIC_ROBINHOOD_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# ---- Hardhat deployments ----
# RPC endpoints (defaults: the public RPCs shown here)
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer private key (NEVER commit a funded key; use a throwaway deployer)
DEPLOYER_PRIVATE_KEY=

# ERC-20 token address the wall charges per stamp (arg to the deploy script)
PAYMENT_TOKEN=
