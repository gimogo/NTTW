# ---- Frontend (Next.js) ----
# Address of the deployed IMDRetroWall contract (per chain you use).
# Leave empty to run the board in "offline preview" mode.
NEXT_PUBLIC_NOTES_CONTRACT_ADDRESS=

# Optional: WalletConnect Cloud project id (enables WalletConnect QR modal).
# Leave empty to use injected wallets (MetaMask, Coinbase Wallet, etc.) only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Hardhat deployments ----
# RPC endpoints
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Deployer private key (NEVER commit a funded key; use a throwaway deployer)
DEPLOYER_PRIVATE_KEY=
